{
  "name": "electron-react-vite",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Electron Vite React Template",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">= 22"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "start": "vite --mode development",
    "start:https": "cross-env VITE_ENABLE_HTTPS=true vite --mode development",
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=16384 vite build --mode production",
    "package": "npm run build && cross-env npm_config_electron_mirror= electron-builder",
    "preview": "vite preview",
    "preview:https": "cross-env VITE_ENABLE_HTTPS=true vite preview",
    "analyzer": "cross-env VITE_ENABLE_ANALYZER=true npm run build",
    "uploadToSentry": "cross-env VITE_UPLOAD_TO_SENTRY=true npm run build",
    "clean": "rimraf dist",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:smoke": "playwright test",
    "test:smoke:report": "playwright show-report",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "commit": "cross-env NODE_OPTIONS=\"--experimental-transform-types --disable-warning ExperimentalWarning\" czg",
    "cspell": "cspell",
    "checkCssVars": "tsx scripts/cssVars/checkCssVars.ts",
    "format": "prettier . --write",
    "lint": "npm run lint:script && npm run lint:style && npm run lint:md",
    "lint:ci": "eslint . --no-error-on-unmatched-pattern && stylelint '**/*.{css,scss,less}' && npm run lint:md",
    "lint:script": "eslint . --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint '**/*.{css,scss,less}' --fix",
    "lint:md": "markdownlint-cli2",
    "api:gen": "orval",
    "i18n": "npx tsx scripts/i18n/index.ts --interactive",
    "i18n:exportLocale": "npx tsx scripts/i18n/exportLocale.ts",
    "prepare": "npx husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npm run lint:script"
    ],
    "**/*.{css,scss,less}": [
      "npm run lint:style"
    ],
    "*": [
      "pretty-quick --staged"
    ]
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
    "@ant-design/icons": "^6.1.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@reduxjs/toolkit": "^2.8.1",
    "@sentry/browser": "^10.26.0",
    "@sentry/core": "^10.26.0",
    "@sentry/react": "^10.26.0",
    "@uiw/react-codemirror": "^4.25.5",
    "antd": "^6.2.3",
    "axios": "^1.13.2",
    "broadcast-channel": "^7.3.0",
    "classnames": "^2.5.1",
    "core-js": "^3.47.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "i18next": "^24.2.2",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "memoize-one": "^6.0.0",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.0",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.2",
    "ts-md5": "^2.0.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/format": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "@electron/fuses": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@sentry/vite-plugin": "^4.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.47.0",
    "@unocss/preset-attributify": "^66.6.0",
    "@unocss/preset-wind": "^66.6.0",
    "@unocss/transformer-directives": "^66.6.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.13",
    "autoprefixer": "^10.4.22",
    "chalk": "^5.6.2",
    "code-inspector-plugin": "^1.3.0",
    "commitizen": "^4.3.1",
    "conventional-changelog-atom": "^5.0.0",
    "cross-env": "^10.1.0",
    "cspell": "^9.6.4",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "inquirer": "^13.0.1",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.19.1",
    "openapi3-ts": "^4.5.0",
    "orval": "^7.16.1",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-loader": "^8.2.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.94.2",
    "stylelint": "^16.26.0",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-icons": "^22.5.0",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-mkcert": "^1.17.9",
    "vitest": "^4.0.13"
  }
}
