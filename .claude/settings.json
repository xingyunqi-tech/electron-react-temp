{
  "permissions": {
    "allow": [
      "Bash(pnpm start:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm api:gen:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:smoke:*)",
      "Bash(pnpm commit:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm i18n:*)",
      "Bash(pnpm cspell:*)",
      "Bash(pnpm analyzer:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git fetch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin master --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout .:*)",
      "Bash(git clean -f:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "enabledMcpjsonServers": ["figma", "context7", "eslint", "chrome-devtools", "sentry"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '🚀 Electron React Template\\n📊 分支: %s\\n📝 未提交: %s 个文件\\n\\n⚡ 快速命令: /review-pr | /quick-fix | /git-workflow | /tools\\n⚠️  规范提醒: API从@/api导入 | 颜色用CSS变量 | Props用TS接口 | IPC用白名单\\n' \"$(git branch --show-current 2>/dev/null || echo 'unknown')\" \"$(git status --short 2>/dev/null | wc -l | tr -d ' ')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in */src/api/generated/*) echo '❌ 禁止修改 src/api/generated/ 目录！该目录由 Orval 自动生成，请使用 pnpm api:gen 更新。' && exit 1;; esac",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "printf '✅ 文件已写入: %s\\n' \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "printf '✏️ 文件已编辑: %s\\n' \"$CLAUDE_FILE_PATH\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '👋 会话结束！\\n\\n📊 Git 状态：\\n' && git status --short 2>/dev/null || echo '无 Git 仓库'"
          }
        ]
      }
    ]
  }
}
